rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Só entra quem fez login com Google e tem um documento em /acesso/{email}.
    // Os e-mails ficam só no banco (cadastrados pelo console), nunca no repositório.
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/acesso/$(request.auth.token.email));
    }

    function itemValido(d) {
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 300
        && d.categoria is string
        && d.tipo in ['Comprar', 'Fazer em casa', 'Ajuste da casa', 'Tarefa', 'Não comprar']
        && d.status in ['Pendente', 'Em andamento', 'Feito', 'Decidido']
        && d.links is list && d.links.size() <= 30
        && (!('imagem' in d) || d.imagem == null || (d.imagem is string && d.imagem.size() < 300000));
    }

    // Cada pessoa só consegue ler o próprio documento de acesso (para o app saber se pode entrar).
    match /acesso/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    match /itens/{id} {
      allow read, delete: if permitido();
      allow create, update: if permitido() && itemValido(request.resource.data);
    }

    // ---------- Lista de presentes (página pública /presentes) ----------
    // Qualquer pessoa com o link lê. Convidados (sem login) só podem ACRESCENTAR uma compra
    // ao fim da lista "compras" de um presente visível; item de compra única só aceita a primeira.

    function compraValida(c) {
      return c.keys().hasOnly(['nome', 'forma', 'mensagem', 'quando'])
        && c.nome is string && c.nome.size() > 0 && c.nome.size() <= 60
        && c.forma in ['link', 'fora']
        && c.mensagem is string && c.mensagem.size() <= 300
        && c.quando is timestamp
        && c.quando > request.time - duration.value(10, 'm')
        && c.quando < request.time + duration.value(10, 'm');
    }

    function novaCompraDeConvidado() {
      let antes = resource.data.compras;
      let depois = request.resource.data.compras;
      return resource.data.visivel == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['compras'])
        && depois.size() == antes.size() + 1
        && (resource.data.multiplo == true || antes.size() == 0)
        && antes.size() < 50
        && depois.hasAll(antes)
        && compraValida(depois[antes.size()]);
    }

    match /presentes/{id} {
      allow read: if true;
      allow create, delete: if permitido();
      allow update: if permitido() || novaCompraDeConvidado();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if permitido();
    }

    match /categorias/{id} {
      allow read, delete: if permitido();
      allow create, update: if permitido()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ordem is number;
    }
  }
}
